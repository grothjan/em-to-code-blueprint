# Bridge: prooph board -> Blueprint
# Copy this file to .env (which is git-ignored) and fill in your values.
# Never commit your API key.

# Required. A WRITE-ENABLED API key for your prooph board workspace.
# Create one in prooph board: Settings → API Keys.
# The key must have write permission because the bridge posts task comments.
# spec-stream documentation recommends read-only keys by default; this bridge
# is an exception — it cannot work without write access.
PROOPHBOARD_API_KEY=pb_your_write_enabled_key_here

# Required. The prooph board API base URL.
# This value is set both here (for the bridge process) and in
# proophboard.spec-stream.json under "env" (for spec-stream to pass it in).
# Change only if you are running a self-hosted instance.
PROOPHBOARD_API_ENDPOINT=https://flow.prooph-board.com/api

# Optional. Set to "true" to generate event-sourced context scaffolding.
# Passes --event-sourced to `codegen context` for every new context.
# BRIDGE_EVENT_SOURCED=false

# Optional. Set to "true" to print the plan as JSON without running codegen
# or posting any comments. Useful for inspecting what would be generated.
# BRIDGE_DRY_RUN=false
